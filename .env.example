# Copy to .env for local development. Do not commit .env.
#
# There was no .env.example for this repo, so the required variables were only
# discoverable by reading source. See docs/audits/01-account-creation-auth.md (L9).

# Dev-server proxy target for /api requests (vite.config.js).
# Leave unset to use the default deployed backend.
VITE_PROXY_TARGET=http://localhost:8000

# Google Identity Services client ID for the Sign in with Google button.
#
# IMPORTANT: use a *separate* OAuth client per environment. Dev, staging, and
# production currently share one ID, which means a dev origin can mint tokens
# your production backend accepts. Create a second client in Google Cloud
# Console with only the dev origins authorised, and use it here.
VITE_GOOGLE_CLIENT_ID=

# NOTE: VITE_API_BASE_URL exists in .env.dev/.env.prod but is read nowhere in
# src/ — every request uses a relative /api path resolved by the Vite proxy in
# dev and by vercel.json rewrites in production. Deliberately omitted here.
